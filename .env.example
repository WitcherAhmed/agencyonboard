# ── Telegram ────────────────────────────────────────────────────────────────
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Your Telegram numeric user/chat id. Send /start to the bot, then run
#   python main.py status --debug   or check the activity log for "chat 12345"
CLIENT_CHAT_ID=

# ── Model (any OpenAI-compatible endpoint) ───────────────────────────────────
AGENT_MODEL=stealth/space-bunny-alpha
# Leave LLM_BASE_URL / LLM_API_KEY blank to reuse the Hermes credentials already
# configured on this machine (Hermes auth.json + config.yaml).
LLM_BASE_URL=
LLM_API_KEY=

# ── Demo client ─────────────────────────────────────────────────────────────
CLIENT_ID=cairo_beans
CLIENT_NAME=Cairo Beans
CLIENT_SERVICES=Social Media Management,Content Creation